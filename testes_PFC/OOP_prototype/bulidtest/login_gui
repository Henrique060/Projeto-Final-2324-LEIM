from root import AppController

class LoginGUI:

    def __init__(self):
        self.root = ctk.CTkToplevel()
        self.fireBaseConfig = {
            "apiKey": "AIzaSyDOhQqt7TvCNTUq8HhJdFP4JoMkXM43SVg",
            "authDomain": "bulidtest.firebaseapp.com",
            "projectId": "bulidtest",
            "databaseURL": "https://console.firebase.google.com/project/bulidtest/database/bulidtest-default-rtdb/data/~2F",
            "storageBucket": "bulidtest.appspot.com",
            "messagingSenderId": "516788987739",
            "appId": "1:516788987739:web:23d1791d0b3380b2a9dc7e",
            "measurementId": "G-GE9F8EHH2W"
        }
        self.firebase = pyrebase.initialize_app(self.fireBaseConfig)
        self.auth = self.firebase.auth()
        self.db = self.firebase.database()
        self.session = None
        self.user_id = None
        self.setup_ui()
        

    
    def setup_ui(self):
        self.root.geometry("800x600")
        self.root.title("Login")
        self.root.resizable(False, False)
        self.root.configure(fg_color="#AFE9DE")
       

        self.username = ctk.CTkLabel(master=self.root,
                                  text="Username:",
                                  width=80,
                                  height=25,
                                  text_color="black",
                                  fg_color="white",
                                  corner_radius=8)
        self.username.place(relx=0.3, rely=0.3, anchor=tkinter.CENTER)

        self.password = ctk.CTkLabel(master=self.root,
                                            text="Password:",
                                            width=80,
                                            height=25,
                                            text_color="black",
                                            fg_color="white",
                                            corner_radius=8)
        self.password.place(relx=0.3, rely=0.5, anchor=tkinter.CENTER)

        ## Entrada de utilizador e placement
        self.username_entry = ctk.CTkEntry(master=self.root,
                                                placeholder_text="Username",
                                                width=180,
                                                height=25,
                                                border_width=2,
                                                corner_radius=10)
        self.username_entry.place(relx=0.65, rely=0.3, anchor=tkinter.CENTER)


        ## Entrada de password e placement
        self.password_entry = ctk.CTkEntry(master=self.root,
                                                placeholder_text="Password",
                                                width=180,
                                                height=25,
                                                border_width=2,
                                                corner_radius=10)
        self.password_entry.place(relx=0.65, rely=0.5, anchor=tkinter.CENTER)

        ## Login action button
        self.login_button = ctk.CTkButton(master=self.root,
                                                text="Login",
                                                width=80,
                                                height=32,
                                                corner_radius=8,
                                                fg_color="white",
                                                text_color="black",
                                                command=self.log_in, ## função de login
                                                hover_color="light blue")
        self.login_button.place(relx=0.71, rely=0.7, anchor=tkinter.CENTER)

        ## Signup button action

        self.signup_button = ctk.CTkButton(master=self.root,
                                                width=80,
                                                height=32,
                                                text="Signup",
                                                command=self.sign_up,
                                                corner_radius=8)
        self.signup_button.place(relx=0.5, rely=0.7, anchor=tkinter.CENTER)

        ## Result output
        self.result = ctk.CTkLabel(master=self.root,
                                        text = "",
                                        width=120,
                                        height=25,
                                        text_color="black",
                                        fg_color="white",
                                        corner_radius=8)
        self.result.place(relx=0.62, rely=0.85, anchor=tkinter.CENTER)

        self.enter_no_login = ctk.CTkButton(master=self.root,
                                        text="Click here to enter without login",
                                        width=120,
                                        height=25,
                                        text_color="black",
                                        fg_color="white",
                                        command=self.enter_no_login,
                                        corner_radius=8)
        self.enter_no_login.place(relx=0.5, rely=0.9, anchor=tkinter.CENTER)



    def sign_up(self):
        email = self.username_entry.get()
        password = self.password_entry.get()

        try:
            token = self.auth.create_user_with_email_and_password(email, password)
            print("Register Successful")
            self.result.configure(text="Registo bem sucedido")
            print(token['idToken'])

            try:
                self.auth.send_email_verification(token['idToken'])
                print("Verification Email Sent")

            except Exception as e:
                print("Verification Email Failed")
                print(e)

        except Exception as e:
            print("Register Failed")
            print(e)


    def log_in(self):
        email = self.username_entry.get()
        password = self.password_entry.get()

        try:
            self.session = self.auth.sign_in_with_email_and_password(email, password)
            user_info = self.auth.get_account_info(self.session['idToken'])
            self.user_id = user_info['users'][0]['localId']
            
            ## Check if email is verified
            if user_info['users'][0]['emailVerified']:
                print("Email Verified")
                self.result.configure(text="Email verificado")

                self.root.destroy()
                app = AppController(self.session, self.firebase, self.db, self.user_id)
                
            else:
                print("Email Not Verified")
                self.result.configure(text="Email não verificado")
                # You might want to provide the user with an option to resend the verification email.

        except:
            print("Email Not Verified")
            self.result.configure(text="Email não verificado")

    
    def enter_no_login(self):
        """ Nesta função, o utilizador pode entrar sem fazer login.
            A sessão está definida a "None".
        """
        self.root.destroy()
        app = AppController(self.session, self.firebase, self.db, self.user_id)


    def run(self):
        self.root.mainloop()

if __name__ == "__main__":
    login = LoginGUI()
